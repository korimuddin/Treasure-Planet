# Copy to .env.local for development. In production set these in Netlify.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
# Use test keys (sk_test_...) until you have run a full deal end to end.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments policy (optional; defaults shown) -------------------------------
# Platform fee in basis points (1000 = 10%).
PLATFORM_FEE_BPS=1000
# Largest purchase the site will process, in pounds.
MAX_DEAL_GBP=10000
# Cards are only offered at or below this many pounds; above it, Pay by Bank only.
CARD_PAYMENT_CAP_GBP=500

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Receives dispute, chargeback and review alerts.
TREASURE_PLANET_ADMIN_EMAIL=

# --- Optional -----------------------------------------------------------------
VOYAGE_MANAGER_THRESHOLD=5000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
